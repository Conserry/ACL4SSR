name: DNS Split - CN Local Overseas Foreign
desc: 国内和微信使用系统 DNS，境外域名使用境外 DoH，境外 DoH 经代理连接
dns:
  # 只用于解析 DNS 服务自身的域名；Stash 要求这里使用 IP。
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29
  # 保留 system 作为启动兜底。Stash 没有 Mihomo 的
  # proxy-server-nameserver，节点域名必须先于代理 DNS 可用。
  nameserver: #!replace
    - system
  # 境外 DoH 按规则经代理连接。
  follow-rule: true
  # 国内和微信使用系统 DNS；代理节点域名使用专用 DoH 直连解析；
  # 其余境外域名再使用经代理连接的境外 DoH。
  nameserver-policy: #!replace
    'mp.weixin.qq.com': system
    '+.weixin.qq.com': system
    '+.wechat.com': system
    '+.wx.qq.com': system
    '+.qpic.cn': system
    '+.qlogo.cn': system
    '+.mmbizurl.cn': system
    '+.gtimg.cn': system
    '+.qq.com': system
    '+.ovalyraa.com':
      - https://hydrogen1693.com:44443/dns-query/48417728-40aa-48cf-8a06-c308d0256139
      - https://subprime7404.com:44443/dns-query/48417728-40aa-48cf-8a06-c308d0256139
      - https://tribunal2944.com/dns-query/48417728-40aa-48cf-8a06-c308d0256139
    'geosite:private': system
    'geosite:cn': system
    'geosite:geolocation-!cn':
      - https://1.1.1.1/dns-query
      - https://8.8.4.4/dns-query
  fake-ip-filter: #!replace
    - '+.lan'
    - '+.local'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - 'localhost.ptlogin2.qq.com'
    - 'localhost.sec.qq.com'
    - '+.in-addr.arpa'
    - '+.ip6.arpa'
    - 'time.*.com'
    - 'time.*.gov'
    - 'pool.ntp.org'
    - 'localhost.work.weixin.qq.com'
# 覆写中的数组默认插入原数组前面。
# 专用 DoH 必须直连，避免解析代理节点时递归依赖代理本身。
rules:
  - DOMAIN,hydrogen1693.com,DIRECT
  - DOMAIN,subprime7404.com,DIRECT
  - DOMAIN,tribunal2944.com,DIRECT
  - IP-CIDR,1.1.1.1/32,🚀 节点选择,no-resolve
  - IP-CIDR,8.8.4.4/32,🚀 节点选择,no-resolve
