name: DNS and WeChat Direct Fix
desc: 国内域名使用系统 DNS，境外域名使用 DoH，微信公众号相关资源强制直连

dns:
  default-nameserver: #!replace
    - 223.5.5.5
    - 1.2.4.8

  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.4.4/dns-query

  # Stash 下建议关闭，避免国内 CDN 静态资源选路变差
  follow-rule: false

  nameserver-policy: #!replace
    'mp.weixin.qq.com': system
    '+.weixin.qq.com': system
    '+.wx.qq.com': system
    '+.qpic.cn': system
    'geosite:private': system
    'geosite:cn': system

  fake-ip-filter: #!replace
    - '+.lan'
    - '+.local'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - 'localhost.ptlogin2.qq.com'
    - 'localhost.sec.qq.com'
    - '+.in-addr.arpa'
    - '+.ip6.arpa'
    - 'time.*.com'
    - 'time.*.gov'
    - 'pool.ntp.org'
    - 'localhost.work.weixin.qq.com'
    - '+.weixin.qq.com'
    - '+.wx.qq.com'
    - '+.qpic.cn'

# 数组默认会插入到原规则列表前面，因此这些规则会优先命中
rules:
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,wx.qq.com,DIRECT
  - DOMAIN-SUFFIX,qpic.cn,DIRECT
